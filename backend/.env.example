DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Optional bootstrap owner. This password is hashed by the seed script and is
# only used when creating the user for the first time.
SEED_OWNER_NAME="Owner"
SEED_OWNER_USERNAME=""
SEED_OWNER_PHONE=""
SEED_OWNER_PASSWORD=""

# SEPARATE MULTIPLE ORIGINS WITH COMMAS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,https://example.com

JWT_ACCESS_TOKEN_SECRET=replace-with-a-strong-access-token-secret
JWT_REFRESH_TOKEN_SECRET=replace-with-a-strong-refresh-token-secret
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
JWT_REFRESH_TOKEN_EXPIRES_IN=30d
